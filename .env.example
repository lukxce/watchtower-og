# Copy to .env.local and fill in what you have. Nothing here is required for
# `npm run dev` — every integration self-defers without its key. Multi-tenancy
# is the one exception: without Clerk keys, the whole app runs as a single
# 'dev-workspace' with no login (see src/lib/tenant.ts).

# --- Database ---
# Neon (or any Postgres) connection string. Omit locally — falls back to an
# embedded PGlite database in ./data.
DATABASE_URL=

# --- Multi-tenancy (Clerk) ---
# Create a free project at https://dashboard.clerk.com, enable Organizations
# under Configure → Organization Settings, then paste both keys below. Until
# both are set, auth is skipped entirely and everything runs as one workspace.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Cron / manual-run auth ---
# Any random string. Protects /api/run and /api/cron/daily from anonymous
# callers. Unset locally = unauthenticated calls allowed.
CRON_SECRET=

# --- AI scoring, battlecards & signal reasoning ---
# Without this, scoring/interpretation fall back to deterministic
# heuristics/rules (still fully functional, just not LLM-reasoned).
ANTHROPIC_API_KEY=

# --- Platform admin (cross-tenant console, see /admin/workspaces) ---
# Comma-separated emails allowed to view every workspace, impersonate one
# ("view as"), and leave corrections that teach the LLM reasoning layer
# (interpretation_feedback). Only checked when Clerk is configured — without
# Clerk (local dev), the single dev-workspace user always has admin access.
PLATFORM_ADMIN_EMAILS=

# --- Capture ---
FIRECRAWL_API_KEY=

# --- Free-tier channel keys ---
META_ADS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
PRODUCTHUNT_TOKEN=
CRUNCHBASE_API_KEY=
GNEWS_API_KEY=

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_STARTER=

# --- Newsletters / secret shopper -------------------------------------------
# The persona inbox address customers forward competitor mail to. The workspace
# rides in a plus-tag (watch+<org>@…), so one inbox serves every tenant.
NEWSLETTER_INBOX=
# Shared secret in the inbound webhook URL. Email providers post as anonymous
# machines and cannot send a bearer token, so the credential lives in the query
# string: /api/inbound?token=<INBOUND_TOKEN>
INBOUND_TOKEN=

# --- Apify (reviews + LinkedIn) ---------------------------------------------
# One token, then an actor id per channel. Each actor defines its OWN input
# schema, so give it a template alongside; {{company}} {{domain}} {{slug}}
# {{url}} are substituted per competitor. Without a template we send a generic
# shape that most actors will reject.
#
#   APIFY_G2_ACTOR=some/g2-scraper
#   APIFY_G2_INPUT={"startUrls":[{"url":"https://www.g2.com/products/{{slug}}/reviews"}],"maxItems":25}
#
# Prefer PAY-PER-RESULT actors: the developer absorbs the residential proxy,
# which is 2-19x cheaper than running a generic scraper yourself.
APIFY_TOKEN=
# memo23/g2-scraper: pay-per-event ($0.005 start + $1.50/1,000 rows, proxy
# included). Chosen over azzouzana because every row carries company_domain —
# a real join key that VERIFIES the row belongs to this competitor instead of
# trusting a name match — and because the same actor also reads pricing tabs,
# competitor lists and compare pages, not just reviews.
# `productSlugs` takes a bare slug and expands to that product's reviews page.
# Same author covers Trustpilot and Capterra in the same output format.
APIFY_G2_ACTOR=memo23/g2-scraper
# Real field names taken from the actor's own JSON tab — its README is stale
# and lists neither searchQueries, onlyNewReviews nor useCachedData.
#
#   searchQueries    search by COMPANY NAME, not slug. More robust than
#                    productSlugs: our slug is ours, and G2's can differ wildly
#                    (agentforce-sales-formerly-salesforce-sales-cloud).
#   onlyNewReviews   true after the first run — a daily monitor only wants what
#                    it has not seen, and rows are what we are billed for.
#   useCachedData    false. Freshness IS the product; a cached answer to "what
#                    changed today" is worse than no answer.
#   proxy            REQUIRED. Datacenter IPs are blocked on the first request.
#
# Opt-ins left off deliberately: reviewInsights ($0.02/product) and
# painPointAnalysis ($0.05/product) are worth revisiting once the base channel
# is proven; enrichEmails/qualifyByPayment are lead-gen features we do not want.
APIFY_G2_INPUT={"searchQueries":["{{company}}"],"maxReviews":25,"maxItems":25,"onlyNewReviews":true,"useCachedData":false,"proxy":{"useApifyProxy":true,"apifyProxyGroups":["RESIDENTIAL"]},"slowMode":true}
APIFY_CAPTERRA_ACTOR=
APIFY_CAPTERRA_INPUT=
APIFY_GLASSDOOR_ACTOR=
APIFY_GLASSDOOR_INPUT=
APIFY_LINKEDIN_ACTOR=
APIFY_LINKEDIN_INPUT=

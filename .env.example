# Copy to .env.local and fill in what you have. Nothing here is required for
# `npm run dev` — every integration self-defers without its key. Multi-tenancy
# is the one exception: without Clerk keys, the whole app runs as a single
# 'dev-workspace' with no login (see src/lib/tenant.ts).
#
# IMPORTANT: a variable that is present but EMPTY counts as unset. Declaring
# FIRECRAWL_API_KEY= with no value does not enable Firecrawl; it silently
# disables the whole third rung of the fetch ladder.
#
# Anything set here must ALSO be set in Vercel for production. Setting it in
# one place only is the most common reason "it works locally".

# --- Database ---------------------------------------------------------------
# Neon (or any Postgres) connection string. Omit locally — falls back to an
# embedded PGlite database in ./data. Note that omitting it means local scripts
# query a DIFFERENT database from production.
DATABASE_URL=

# --- Multi-tenancy (Clerk) --------------------------------------------------
# Free project at https://dashboard.clerk.com, enable Organizations under
# Configure → Organization Settings, then paste both keys. Until both are set,
# auth is skipped and everything runs as one workspace.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Cron / manual-run auth -------------------------------------------------
# Any random string (`openssl rand -hex 32`). Protects /api/run,
# /api/cron/daily and /api/health from anonymous callers. Unset = anyone can
# trigger a collection run.
CRON_SECRET=

# --- AI scoring, battlecards & signal reasoning -----------------------------
# Without this, scoring/interpretation fall back to deterministic heuristics
# (still functional, just not LLM-reasoned).
ANTHROPIC_API_KEY=

# --- Platform admin (cross-tenant console, /admin/workspaces) ---------------
# Comma-separated emails allowed to view every workspace, impersonate one, and
# leave corrections that teach the reasoning layer. Only checked when Clerk is
# configured — without Clerk, the single dev-workspace user always has access.
PLATFORM_ADMIN_EMAILS=

# --- Capture ----------------------------------------------------------------
# The third rung of the fetch ladder: plain fetch → retry → Firecrawl render.
# Without it, any JS-rendered or bot-walled page simply fails, which degrades
# news, jobs, logos, techstack, events, googleplay, subdomains, youtube,
# adsLinkedin, trustpilot and linkedinPosts. https://firecrawl.dev
FIRECRAWL_API_KEY=

# --- Free channel keys ------------------------------------------------------
# Meta Ad Library via Graph API — https://developers.facebook.com/tools/explorer
META_ADS_TOKEN=
# Reddit OAuth app (type "script") — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Product Hunt GraphQL — https://www.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=
# Optional: upgrades `news` from Google News RSS to GNews — https://gnews.io
GNEWS_API_KEY=

# --- Newsletters / secret shopper -------------------------------------------
# The persona inbox address competitor mail is forwarded to. The workspace
# rides in a plus-tag (watch+<org>@…), so one inbox serves every tenant.
NEWSLETTER_INBOX=
# Shared secret in the inbound webhook URL. Email providers post as anonymous
# machines and cannot send a bearer token, so the credential lives in the query
# string: /api/inbound?token=<INBOUND_TOKEN>
INBOUND_TOKEN=

# --- Billing (Stripe) -------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_STARTER=

# --- Paid channels ----------------------------------------------------------
# Traffic + Google Trends. $50 minimum deposit. https://dataforseo.com
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Apify (reviews + LinkedIn) ---------------------------------------------
# One token, then an actor id per channel. Actor ids may be "user/name" or the
# short console id — both work.
#
# Prefer PAY-PER-EVENT actors: the developer absorbs the residential proxy,
# which is far cheaper than running a generic scraper yourself.
APIFY_TOKEN=

# Covers G2, Capterra and TrustRadius in one run, queried by DOMAIN rather
# than product name — the identity key itself, so no slug resolution and none
# of the same-name failures every other channel hit.
#
# It does NOT cover Gartner, despite Gartner appearing in its platform list —
# it bills itself "All-in-One Review Scraper: G2, Capterra & Trustpilot".
# Measured: zero Gartner rows for Klue, which has 20 Gartner reviews at 4.8.
# Use APIFY_GARTNER_ACTOR for that.
#
# Trustpilot returns nothing for most B2B vendors because they have no profile
# — Klue and Crayon genuinely do not. That is reported as "no listing found",
# not as a failure.
#
# It enforces maxResults >= 100 and has no incremental mode, so every run
# re-pulls and re-bills reviews already held. That puts this channel on a
# MONTHLY cadence: ~$0.44 per competitor per month. Reviews move slowly enough
# that monthly loses nothing.
APIFY_REVIEWS_ACTOR=zen-studio/software-review-scraper

# Glassdoor. Unlike the above it HAS incremental collection
# (monitoringModeForReviews + saveOnlyUniqueItems), so repeat runs bill only
# new reviews and it can run weekly.
#
# Needs the employer Reviews URL per competitor — Glassdoor keys pages by an
# internal id (…-E2919580.htm) that cannot be derived. Set it in the app on
# Battlecards → Channel sources, or with:
#   node scripts/set-source.mjs <slug> glassdoor <url>
APIFY_GLASSDOOR_ACTOR=memo23/glassdoor-scraper-ppr

# Gartner Peer Insights. Takes a full product URL, which encodes market AND
# vendor AND product — also set per competitor, same two ways as Glassdoor.
APIFY_GARTNER_ACTOR=zen-studio/gartner-review-scraper

# LinkedIn company posts. Takes `targetUrls` (NOT `companies` — an unknown
# field makes it exit cleanly with zero rows, which looks like a quiet
# competitor rather than a broken config).
#
# The company URL is discovered from the competitor's own site footer, which
# covered 8 of 10 real cases; the rest are set in the app. Never derived: the
# slug is not the domain (crayon.co → crayon-co, grin.co → grin-inc-,
# visualping.io → 9480446).
APIFY_LINKEDIN_ACTOR=harvestapi/linkedin-company-posts

# Optional per-actor input templates. {{company}} {{domain}} {{slug}} {{url}}
# are substituted per competitor. Leave UNSET unless an actor rejects our
# default shape — the defaults are verified against live runs.
APIFY_REVIEWS_INPUT=
APIFY_GLASSDOOR_INPUT=
APIFY_GARTNER_INPUT=
APIFY_LINKEDIN_INPUT=

# Optional per-channel overrides, only needed if you stop using the combined
# reviews actor above.
APIFY_G2_ACTOR=
APIFY_CAPTERRA_ACTOR=
APIFY_TRUSTRADIUS_ACTOR=
APIFY_TRUSTPILOT_ACTOR=

# Test-only knobs. Deployments need neither.
#   APIFY_MAX_REVIEWS=5   rows per review run (default 25)
#   APIFY_MAX_POSTS=5     posts per LinkedIn run (default 25)
